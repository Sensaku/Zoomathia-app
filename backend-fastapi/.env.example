# Configuration locale de FastAPI.
# En Docker Compose, SPARQL_ENDPOINT est défini dans le fichier .env à la racine.
# Pour un Corese installé sur le même hôte qu'un backend lancé localement :
PROJECT_NAME=Zoomathia API
VERSION=1.0.0
HOST=0.0.0.0
PORT=3001
SPARQL_ENDPOINT=http://zoomathia.i3s.unice.fr/sparql
SPARQL_TIMEOUT=30

# Pydantic attend une liste JSON, pas une liste séparée par des virgules.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Chemins locaux relatifs au dossier backend-fastapi.
STAGING_DB_PATH=data/staging.db
XML_DATA_DIR=data/files
QUERIES_DIR=data/queries
