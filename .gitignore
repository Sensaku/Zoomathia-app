# Documentation générée par les agents à la racine
# (seuls README, AGENTS et CLAUDE sont versionnés ; la doc durable va dans docs/)
/*.md
!/README.md
!/AGENTS.md
!/CLAUDE.md
!/CHANGELOG.md

# Réglages Claude Code personnels
.claude/settings.local.json

# Ressources locales non versionnées
/scripts/
/dumps/

# Variables d'environnement locales
.env
.env.*
!.env.example
!**/.env.example

# Site de documentation généré (MkDocs)
/site/

# Python bytecode, regenerated by every run
__pycache__/
*.py[cod]

# Application database: it holds accounts (emails, password hashes) and must never be published.
# The file backend-fastapi/data/staging.db is still tracked until it is untracked at commit time.
backend-fastapi/data/*.db
backend-fastapi/data/*.db-wal
backend-fastapi/data/*.db-shm
