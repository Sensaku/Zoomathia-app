# Endpoint SPARQL accessible depuis le conteneur backend.
# Si Corese tourne sur le même serveur Ubuntu, utiliser l'adresse de l'hôte Docker.
SPARQL_ENDPOINT=http://host.docker.internal:8080/sparql
# Si Corese est sur une autre machine, remplacer par son adresse IP ou DNS.
# SPARQL_ENDPOINT=http://192.168.1.20:8080/sparql

# Délai maximal des requêtes FastAPI vers Corese, en secondes.
SPARQL_TIMEOUT=30

# Origines autorisées par l'API (format JSON attendu par Pydantic).
CORS_ORIGINS=["http://localhost","http://127.0.0.1","http://localhost:5173","http://127.0.0.1:5173"]

# Port HTTP du frontend en production (le port 8080 précédemment réservé à Corese).
FRONTEND_PORT=8080

# URL de l'API injectée dans le build du frontend.
# /api est routé vers FastAPI par Nginx dans le Compose.
VITE_API_URL=/api
